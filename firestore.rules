rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Firebase Auth token claims are server-signed. Keep the existing custom
    // claim path while allowing the designated Google account to administer
    // editorial data without a separate claim-provisioning step.
    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true || (
        request.auth.token.email == 'taizu61zx@gmail.com'
        && request.auth.token.email_verified == true
      ));
    }
    function owns(resourceData) { return signedIn() && resourceData.authorId == request.auth.uid; }
    function ownsCourse(courseId) { return signedIn() && get(/databases/$(database)/documents/courses/$(courseId)).data.authorId == request.auth.uid; }
    function validVisibility(value) { return value in ['public', 'limited', 'private']; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId
        || resource.data.mapVisibility == 'all'
        || exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(userId)));
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
      match /following/{targetId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /presence/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || (
        resource.data.allowedViewerIds is list
        && request.auth.uid in resource.data.allowedViewerIds
      ));
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.allowedViewerIds is list;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /courses/{courseId} {
      function globallyBlocked() {
        return signedIn()
          && get(/databases/$(database)/documents/users/$(resource.data.authorId)).data.blockedUserIds is list
          && request.auth.uid in get(/databases/$(database)/documents/users/$(resource.data.authorId)).data.blockedUserIds;
      }
      function courseBlocked() { return signedIn() && (
        (resource.data.blockedViewerIds is list && request.auth.uid in resource.data.blockedViewerIds)
        || (resource.data.globalBlockedViewerIds is list && request.auth.uid in resource.data.globalBlockedViewerIds)
      ); }
      function explicitlyAllowed() { return signedIn() && resource.data.allowedViewerIds is list && request.auth.uid in resource.data.allowedViewerIds; }
      // Direct shared links enforce both blacklist levels. Collection queries
      // must remain provable from visibility/author/share fields; the client
      // additionally removes blocked documents from catalogue results.
      allow get: if !globallyBlocked() && !courseBlocked() && (resource.data.visibility == 'public' || owns(resource.data) || explicitlyAllowed());
      allow list: if resource.data.visibility == 'public' || owns(resource.data) || explicitlyAllowed();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && validVisibility(request.resource.data.visibility)
        && request.resource.data.name is string
        && request.resource.data.route is list
        && request.resource.data.route.size() >= 2;
      allow update: if owns(resource.data)
        && request.resource.data.authorId == resource.data.authorId
        && validVisibility(request.resource.data.visibility);
      allow delete: if owns(resource.data);

      match /ratings/{userId} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.curves >= 1 && request.resource.data.curves <= 5
          && request.resource.data.elevation >= 1 && request.resource.data.elevation <= 5
          && request.resource.data.width >= 1 && request.resource.data.width <= 5
          && request.resource.data.scenery >= 1 && request.resource.data.scenery <= 5;
        allow delete: if (signedIn() && request.auth.uid == userId) || ownsCourse(courseId);
      }
      match /likes/{userId} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid == userId;
        allow delete: if (signedIn() && request.auth.uid == userId) || ownsCourse(courseId);
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body is string && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000;
        allow update: if signedIn() && resource.data.authorId == request.auth.uid;
        allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || ownsCourse(courseId);
      }
      match /live/{infoId} {
        allow read: if true;
        allow create, update: if isAdmin();
        allow delete: if isAdmin() || ownsCourse(courseId);
      }
    }

    match /reports/{reportId} {
      allow read: if signedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.type in ['toll-info', 'road-condition', 'discovery', 'quality', 'road']
        && request.resource.data.courseId is string
        && request.resource.data.sourceUrl is string
        && request.resource.data.sourceUrl.size() <= 1000
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.status == 'pending');
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /adminQueue/{itemId} {
      allow read, update: if isAdmin();
      allow create: if signedIn();
      allow delete: if isAdmin();
    }
  }
}
