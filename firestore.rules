rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(resourceData) { return signedIn() && resourceData.authorId == request.auth.uid; }
    function validVisibility(value) { return value in ['public', 'limited', 'private']; }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /courses/{courseId} {
      allow get: if resource.data.visibility in ['public', 'limited'] || owns(resource.data);
      allow list: if resource.data.visibility == 'public' || owns(resource.data);
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && validVisibility(request.resource.data.visibility)
        && request.resource.data.name is string
        && request.resource.data.route is list
        && request.resource.data.route.size() >= 2;
      allow update: if owns(resource.data)
        && request.resource.data.authorId == resource.data.authorId
        && validVisibility(request.resource.data.visibility);
      allow delete: if owns(resource.data);

      match /ratings/{userId} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.curves >= 1 && request.resource.data.curves <= 5
          && request.resource.data.elevation >= 1 && request.resource.data.elevation <= 5
          && request.resource.data.width >= 1 && request.resource.data.width <= 5
          && request.resource.data.scenery >= 1 && request.resource.data.scenery <= 5;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /reports/{reportId} {
      allow read: if signedIn()
        && (resource.data.authorId == request.auth.uid || request.auth.token.admin == true);
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.type in ['toll-info', 'road-condition']
        && request.resource.data.courseId is string
        && request.resource.data.sourceUrl is string
        && request.resource.data.sourceUrl.size() <= 1000
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.status == 'pending';
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
