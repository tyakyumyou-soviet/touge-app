rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isPrimarySuperAdmin() {
      return signedIn() && request.auth.token.email == 'taizu61zx@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function assignedRole(role) {
      return signedIn() && exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role == role;
    }
    function isSuperAdmin() { return isPrimarySuperAdmin() || assignedRole('superadmin'); }
    function isAdmin() {
      return isSuperAdmin() || assignedRole('admin');
    }
    function hasAccountId() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountId is string;
    }
    function owns(resourceData) { return signedIn() && resourceData.authorId == request.auth.uid; }
    function ownsCourse(courseId) { return signedIn() && get(/databases/$(database)/documents/courses/$(courseId)).data.authorId == request.auth.uid; }
    function validVisibility(value) { return value in ['public', 'limited', 'private']; }
    function validAccountIdClaim(userId) {
      return ('accountId' in resource.data && request.resource.data.accountId == resource.data.accountId)
        || (!('accountId' in resource.data)
          && request.resource.data.accountId is string
          && request.resource.data.accountId.matches('^[a-z0-9][a-z0-9_-]{2,19}$')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountId', 'displayName', 'photoURL', 'updatedAt'])
          && getAfter(/databases/$(database)/documents/accountIds/$(request.resource.data.accountId)).data.uid == userId);
    }
    function friendWith(userId) {
      let first = request.auth.uid + '~' + userId;
      let second = userId + '~' + request.auth.uid;
      return (exists(/databases/$(database)/documents/friendships/$(first)) && get(/databases/$(database)/documents/friendships/$(first)).data.status == 'accepted')
        || (exists(/databases/$(database)/documents/friendships/$(second)) && get(/databases/$(database)/documents/friendships/$(second)).data.status == 'accepted');
    }
    function courseBlocksViewer(courseData) {
      return (('blockedViewerIds' in courseData) && courseData.blockedViewerIds is list && request.auth.uid in courseData.blockedViewerIds)
        || (('globalBlockedViewerIds' in courseData) && courseData.globalBlockedViewerIds is list && request.auth.uid in courseData.globalBlockedViewerIds);
    }
    function canViewCourse(courseData) {
      return ('isSeed' in courseData && courseData.isSeed == true)
        || isAdmin()
        || owns(courseData)
        // allowedViewerIds is a materialized audience snapshot. It must never
        // outlive the friendship: a former or blocked friend loses access even
        // before the asynchronous audience reconciliation job finishes.
        || (signedIn()
          && 'allowedViewerIds' in courseData
          && courseData.allowedViewerIds is list
          && request.auth.uid in courseData.allowedViewerIds
          && friendWith(courseData.authorId)
          && !courseBlocksViewer(courseData));
    }

    match /friendDirectory/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if hasAccountId() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'searchName'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
        && request.resource.data.searchName is string && request.resource.data.searchName.size() <= 160;
      allow delete: if hasAccountId() && request.auth.uid == userId;
    }
    match /accountIds/{accountId} {
      allow get: if signedIn();
      allow list: if isSuperAdmin();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'accountId', 'displayName', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.accountId == accountId
        && accountId.matches('^[a-z0-9][a-z0-9_-]{2,19}$')
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountId == accountId;
      allow update, delete: if false;
    }
    match /adminRoles/{userId} {
      // A driver may confirm only their own access level. Role assignments for
      // every other account are operational metadata and are visible solely to
      // the fixed/delegated super administrators.
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if hasAccountId() && isSuperAdmin() && userId != request.auth.uid
        && request.resource.data.keys().hasOnly(['role', 'accountId', 'displayName', 'updatedBy', 'updatedAt'])
        && request.resource.data.role in ['admin', 'superadmin']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/users/$(userId)).data.accountId == request.resource.data.accountId;
      allow delete: if hasAccountId() && isSuperAdmin() && userId != request.auth.uid;
    }
    match /friendships/{pairId} {
      allow get: if isSuperAdmin() || (signedIn() && (!exists(/databases/$(database)/documents/friendships/$(pairId)) || request.auth.uid in resource.data.members));
      allow list: if isSuperAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      allow create: if hasAccountId()
        && request.resource.data.keys().hasOnly(['sender', 'recipient', 'members', 'names', 'status', 'updatedAt'])
        && request.resource.data.sender == request.auth.uid
        && request.resource.data.recipient is string && request.resource.data.recipient != request.auth.uid
        && (pairId == request.resource.data.sender + '~' + request.resource.data.recipient || pairId == request.resource.data.recipient + '~' + request.resource.data.sender)
        && request.resource.data.members == [request.resource.data.sender, request.resource.data.recipient]
        && request.resource.data.names is map
        && request.resource.data.names.keys().hasOnly([request.resource.data.sender, request.resource.data.recipient])
        && request.resource.data.names[request.resource.data.sender] is string
        && request.resource.data.names[request.resource.data.sender].size() <= 80
        && request.resource.data.names[request.resource.data.recipient] == get(/databases/$(database)/documents/users/$(request.resource.data.recipient)).data.displayName
        && request.resource.data.status == 'pending'
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipient))
        && get(/databases/$(database)/documents/users/$(request.resource.data.recipient)).data.accountId is string;
      allow update: if hasAccountId() && resource.data.recipient == request.auth.uid
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if hasAccountId() && request.auth.uid in resource.data.members;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.accountId is string
        && request.resource.data.accountId.matches('^[a-z0-9][a-z0-9_-]{2,19}$')
        && getAfter(/databases/$(database)/documents/accountIds/$(request.resource.data.accountId)).data.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId && validAccountIdClaim(userId);
      allow delete: if false;
      match /following/{targetId} {
        allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
        allow create, delete: if hasAccountId() && request.auth.uid == userId;
      }
    }

    match /publicProfiles/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isSuperAdmin()
        // Legacy `all` profiles are now read as friend-only until their owner
        // next saves the normalized `friends` setting.
        || (resource.data.mapVisibility in ['friends', 'all'] && friendWith(userId))
        || (resource.data.mapVisibility == 'lists'
          && resource.data.mapAllowedViewerIds is list
          && request.auth.uid in resource.data.mapAllowedViewerIds
          && friendWith(userId)));
      allow list: if false;
      allow create, update: if hasAccountId() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'bio', 'homeArea', 'mapVisibility', 'mapAllowedViewerIds', 'vehicleName', 'vehicleDetails', 'socialLinks', 'showcasePostUrls', 'updatedAt'])
        && request.resource.data.mapVisibility in ['friends', 'lists', 'none']
        && (!(request.resource.data.mapVisibility == 'lists') || request.resource.data.mapAllowedViewerIds is list)
        && request.resource.data.updatedAt == request.time;
      allow delete: if hasAccountId() && request.auth.uid == userId;
    }

    match /presence/{userId} {
      allow read: if isSuperAdmin() || (signedIn() && (request.auth.uid == userId || (
        resource.data.allowedViewerIds is list
        && request.auth.uid in resource.data.allowedViewerIds
        && friendWith(userId)
      )));
      allow create, update: if hasAccountId()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.allowedViewerIds is list;
      allow delete: if hasAccountId() && request.auth.uid == userId;
    }

    match /courses/{courseId} {
      allow get, list: if canViewCourse(resource.data);
      allow create: if hasAccountId()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.visibility == 'limited'
        && request.resource.data.publicSharingConfirmed == false
        && (!('isSeed' in request.resource.data) || request.resource.data.isSeed == false)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.route is list
        && request.resource.data.route.size() >= 2 && request.resource.data.route.size() <= 3000
        && request.resource.data.allowedViewerIds is list && request.resource.data.allowedViewerIds.size() <= 500;
      allow update: if hasAccountId() && (owns(resource.data) || isAdmin())
        && request.resource.data.authorId == resource.data.authorId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSeed'])
        && request.resource.data.visibility == 'limited'
        && request.resource.data.publicSharingConfirmed == false
        && (!('allowedViewerIds' in request.resource.data) || (request.resource.data.allowedViewerIds is list && request.resource.data.allowedViewerIds.size() <= 500))
        && (!('blockedViewerIds' in request.resource.data) || (request.resource.data.blockedViewerIds is list && request.resource.data.blockedViewerIds.size() <= 500))
        && (!('globalBlockedViewerIds' in request.resource.data) || (request.resource.data.globalBlockedViewerIds is list && request.resource.data.globalBlockedViewerIds.size() <= 500));
      allow delete: if hasAccountId() && (owns(resource.data) || isAdmin());

      match /ratings/{userId} {
        allow read: if canViewCourse(get(/databases/$(database)/documents/courses/$(courseId)).data);
        allow create, update: if hasAccountId()
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['userId', 'userName', 'curves', 'elevation', 'width', 'scenery', 'surface', 'traffic', 'access', 'comment', 'updatedAt'])
          && request.resource.data.userName is string && request.resource.data.userName.size() <= 80
          && request.resource.data.curves >= 1 && request.resource.data.curves <= 5
          && request.resource.data.elevation >= 1 && request.resource.data.elevation <= 5
          && request.resource.data.width >= 1 && request.resource.data.width <= 5
          && request.resource.data.scenery >= 1 && request.resource.data.scenery <= 5
          && request.resource.data.surface >= 1 && request.resource.data.surface <= 5
          && request.resource.data.traffic >= 1 && request.resource.data.traffic <= 5
          && request.resource.data.access >= 1 && request.resource.data.access <= 5
          && (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 1000));
        allow delete: if hasAccountId() && (request.auth.uid == userId || ownsCourse(courseId));
      }
      match /likes/{userId} {
        allow read: if canViewCourse(get(/databases/$(database)/documents/courses/$(courseId)).data);
        allow create: if hasAccountId() && request.auth.uid == userId;
        allow delete: if hasAccountId() && (request.auth.uid == userId || ownsCourse(courseId));
      }
      match /comments/{commentId} {
        allow read: if canViewCourse(get(/databases/$(database)/documents/courses/$(courseId)).data);
        allow create: if hasAccountId() && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body is string && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000;
        // Comments are currently append/delete only. Do not leave a broad
        // update permission that lets an author rewrite the author identity,
        // timestamps, or server-owned counters.
        allow update: if false;
        allow delete: if hasAccountId() && (resource.data.authorId == request.auth.uid || ownsCourse(courseId));
      }
      match /live/{infoId} {
        allow read: if canViewCourse(get(/databases/$(database)/documents/courses/$(courseId)).data);
        allow create, update: if hasAccountId() && isAdmin();
        allow delete: if hasAccountId() && (isAdmin() || ownsCourse(courseId));
      }
    }

    match /courseAudiences/{courseId} {
      function courseOwner() { return getAfter(/databases/$(database)/documents/courses/$(courseId)).data.authorId; }
      allow read: if signedIn() && (request.auth.uid == resource.data.ownerId || isAdmin());
      allow create, update: if hasAccountId() && (request.auth.uid == courseOwner() || isAdmin())
        && request.resource.data.keys().hasOnly(['ownerId', 'mode', 'listIds', 'listNames', 'updatedAt'])
        && request.resource.data.ownerId == courseOwner()
        && request.resource.data.mode in ['all-friends', 'lists']
        && request.resource.data.listIds is list
        && request.resource.data.listNames is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if hasAccountId() && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    match /reports/{reportId} {
      allow read: if signedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if hasAccountId()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.type in ['toll-info', 'road-condition', 'discovery', 'quality', 'road']
        && request.resource.data.courseId is string
        && request.resource.data.sourceUrl is string
        && request.resource.data.sourceUrl.size() <= 1000
        && request.resource.data.status == 'pending';
      allow update: if hasAccountId() && (isAdmin() || (
        resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.status == 'pending'));
      allow delete: if hasAccountId() && resource.data.authorId == request.auth.uid;
    }

    match /adminQueue/{itemId} {
      allow read: if isAdmin();
      allow update: if hasAccountId() && isAdmin();
      allow create: if hasAccountId();
      allow delete: if hasAccountId() && isAdmin();
    }
  }
}
